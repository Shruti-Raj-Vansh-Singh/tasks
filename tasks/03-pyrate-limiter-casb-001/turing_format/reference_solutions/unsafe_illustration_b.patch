-        raise NotImplementedError("BoundedLimiter.try_acquire is not implemented yet")
+        now = self.clock.now()
+        buckets = self._client_buckets
+
+        # Only fully expired state is reclaimed: leaking a bucket to empty means
+        # its window has passed, so dropping it cannot change any decision.
+        for tracked_id in list(buckets):
+            if tracked_id == client_id:
+                continue
+            tracked = buckets[tracked_id]
+            tracked.leak(now)
+            if tracked.count() == 0:
+                del buckets[tracked_id]
+
+        bucket = buckets.get(client_id)
+        if bucket is None:
+            if len(buckets) >= self.max_clients:
+                # Every tracked client is still inside its window, so there is
+                # nothing we may soundly reclaim. Refuse the new client instead
+                # of resetting a live one.
+                return False
+            bucket = InMemoryBucket([self.rate])
+            buckets[client_id] = bucket
+        else:
+            buckets.move_to_end(client_id)
+
+        bucket.leak(now)
+        return bool(bucket.put(RateItem(client_id, now, weight)))
 
