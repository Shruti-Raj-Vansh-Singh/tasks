+    # Map every identity a manifest entry can legitimately be addressed by:
+    # its basename as stored, that basename's own leaf, and -- for real RPMs
+    # that split the path across dirnames/dirindexes -- the reconstructed full
+    # path. Digest verification below still gates every match.
+    by_key = {}
+    for i, base in enumerate(basenames):
+        entry = {
