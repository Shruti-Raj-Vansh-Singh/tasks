+        by_key.setdefault(os.path.basename(nb), entry)
+        if i < len(dirindexes) and dirindexes[i] < len(dirnames):
+            by_key.setdefault(_norm(dirnames[dirindexes[i]] + base), entry)
+    return by_key, _ALGO.get(algo, "sha256")
