+def _header_index(headers):
+    basenames = [_b(x) for x in headers.get("basenames", [])]
+    dirnames = [_b(x) for x in headers.get("dirnames", [])]
+    dirindexes = headers.get("dirindexes", []) or []
+    digs = [_b(x) for x in headers.get("filemd5s", [])]
+    sizes = headers.get("filesizes", []) or []
+    algo = headers.get("filedigestalgo", 8)
+    if isinstance(algo, (list, tuple)):
