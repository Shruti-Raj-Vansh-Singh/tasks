-    raise NotImplementedError("install_rpm is not implemented yet")
+def _header_maps(headers):
+    """name -> (digest, size) from the parallel header tables."""
+    basenames = [b.decode() if isinstance(b, bytes) else b
+                 for b in headers.get("basenames", [])]
+    digs = [d.decode() if isinstance(d, bytes) else d
+            for d in headers.get("filemd5s", [])]
+    sizes = headers.get("filesizes", []) or []
+    dig_by = {}
+    size_by = {}
+    for i, nm in enumerate(basenames):
+        if i < len(digs):
+            dig_by[nm] = digs[i]
+        if i < len(sizes):
+            size_by[nm] = sizes[i]
+    return dig_by, size_by
+
+
+def install_rpm(rpm_path, dest_dir):
+    installed = []
+    with rpmfile.open(rpm_path) as rpm:
+        dig_by, size_by = _header_maps(rpm.headers)
+        for m in rpm.getmembers():
+            data = rpm.extractfile(m).read()
+            leaf = os.path.basename(m.name)
+            out = os.path.join(dest_dir, m.name.lstrip("./"))
+            os.makedirs(os.path.dirname(out) or dest_dir, exist_ok=True)
+            with open(out, "wb") as f:
+                f.write(data)
+            installed.append({
+                "path": m.name,
+                "digest": dig_by.get(leaf, dig_by.get(m.name, "")),
+                "size": size_by.get(leaf, size_by.get(m.name, m.size)),
+            })
+    return {"installed": installed}
